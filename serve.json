{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/chapa2", "destination": "/index.html" },
    { "source": "/chapa2/assets/**", "destination": "/assets/**" },
    { "source": "/chapa2/**", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
